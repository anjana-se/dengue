FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci --frozen-lockfile

COPY tsconfig.json ./
COPY src ./src

RUN npm run build

# ─── Production image ─────────────────────────────────────────────────────────
FROM node:20-alpine AS production
WORKDIR /app

COPY package*.json ./
RUN npm ci --frozen-lockfile --omit=dev

COPY --from=builder /app/dist ./dist

# Shared uploads volume (same as api for local storage driver)
RUN mkdir -p uploads

# No EXPOSE — worker only consumes from Redis, no inbound HTTP
CMD ["node", "dist/worker.js"]
