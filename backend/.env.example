NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dengueguard

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_LENGTH=6
OTP_EXPIRES_IN_SECONDS=300

# Gemini AI
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash-lite
GEMINI_VISION_MODEL=gemini-2.0-flash-lite
GEMINI_TRANSLATION_MODEL=gemini-2.0-flash-lite
AI_ANALYSIS_CONFIDENCE_THRESHOLD=0.70

# Storage
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_EXPIRES_SECONDS=900
MAX_UPLOAD_SIZE_MB=15

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Socket.IO
SOCKET_IO_PATH=/socket.io

# Scheduler
ZONE_RISK_RECOMPUTE_CRON=*/15 * * * *

# Logging
LOG_LEVEL=info

# OAuth (community reporters - FR-04)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# SMS OTP provider (TBD - pick provider before building OTP delivery)
SMS_OTP_PROVIDER_API_KEY=
