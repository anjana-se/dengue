{
  "name": "dengueguard-backend",
  "version": "0.1.0",
  "description": "DengueGuard backend — Express API + BullMQ worker + Gemini AI",
  "private": true,
  "scripts": {
    "dev:api": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc --project tsconfig.json",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "migrate": "ts-node scripts/migrate.ts",
    "seed": "ts-node scripts/seed.ts",
    "clear:zones": "ts-node scripts/clear_zones.ts",
    "reset:queue": "ts-node scripts/reset_ai_queue.ts",
    "reset:all": "ts-node scripts/reset_all_reports_and_zones.ts",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.ts'",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@google/generative-ai": "^0.24.0",
    "@types/dotenv": "^6.1.1",
    "bullmq": "^5.29.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.3",
    "redis": "^6.1.0",
    "resend": "^6.17.2",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.3",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.13",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
